# Public app origin used to validate Work result submissions.
APP_ORIGIN=https://your-app.example

# Random server-side HMAC key, at least 32 characters.
WORK_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters

# Durable Phase 0 storage. Use a modern sb_secret_... key, server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key
