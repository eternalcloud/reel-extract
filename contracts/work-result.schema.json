{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reel-extract.local/contracts/work-result.schema.json",
  "title": "Reel Extract Work Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "attempt",
    "candidates",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "confidence",
        "verification_status",
        "evidence",
        "verification_sources",
        "notes"
      ],
      "properties": {
        "kind": {
          "enum": ["place", "website"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "enum": [
            "observed",
            "verified",
            "probable",
            "conflict",
            "unverified"
          ]
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "website": {
          "$ref": "#/$defs/website"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "verification_sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/verificationSource"
          }
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "place"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["place"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "website"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["website"],
            "properties": {
              "website": {
                "allOf": [
                  {
                    "$ref": "#/$defs/website"
                  },
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "observed_url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https?://"
                          }
                        },
                        "required": ["observed_url"]
                      },
                      {
                        "properties": {
                          "official_url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https?://"
                          }
                        },
                        "required": ["official_url"]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "locality",
        "region",
        "country",
        "latitude",
        "longitude"
      ],
      "properties": {
        "address": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "locality": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "region": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "country": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "latitude": {
          "type": ["number", "null"],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_url",
        "official_url"
      ],
      "properties": {
        "observed_url": {
          "type": ["string", "null"],
          "format": "uri",
          "maxLength": 2048
        },
        "official_url": {
          "type": ["string", "null"],
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "timestamp_ms",
        "text",
        "artifact_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "caption",
            "transcript",
            "frame",
            "source_metadata"
          ]
        },
        "timestamp_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "text": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "artifact_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "verificationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "supports"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
